# FinalSay environment configuration (example).
#
# Copy to `.env` in the directory you run the backend from (typically
# `backend/`) and adjust as needed. Most variables use the FINALSAY_ prefix;
# Polygon Amoy variables use the names below exactly.
# Defaults: SQLite + local semantic comparison + LOCAL anchor. No paid API keys
# are required; model weights are downloaded and cached on the first run.

# --- Runtime environment ----------------------------------------------------
# development keeps local SQLite/dev auth defaults. Production startup requires
# PostgreSQL, a strong JWT secret, and explicit HTTPS CORS origins.
FINALSAY_ENVIRONMENT=development

# --- Database -----------------------------------------------------------------
# SQLite (default, no external service needed):
FINALSAY_DATABASE_URL=sqlite:///./finalsay.db
# PostgreSQL (opt-in; e.g. via `scripts/run_demo.sh --postgres`):
# FINALSAY_DATABASE_URL=postgresql+psycopg2://finalsay:finalsay@127.0.0.1:5432/finalsay

# --- Comparison model ---------------------------------------------------------
# semantic = local embedding retrieval + NLI cross-encoder (default)
# mock     = deterministic offline rule model (explicit fallback/test option)
# hf       = prior BART zero-shot classifier (legacy evaluation option)
FINALSAY_COMPARISON_MODEL=semantic
FINALSAY_HF_MODEL_NAME=facebook/bart-large-mnli
FINALSAY_SEMANTIC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FINALSAY_SEMANTIC_NLI_MODEL=cross-encoder/nli-deberta-v3-small

# --- Public notice scraping --------------------------------------------------
# Poll active + enabled institutional sources at startup and then this interval.
# Two hours keeps up with frequent university circular updates while spreading
# requests across the day; transient failed cycles use bounded retry backoff.
# Set to 0 to disable automatic polling while retaining Admin → Sources manual poll.
FINALSAY_SCRAPE_INTERVAL_SECONDS=7200

# --- Provenance anchor --------------------------------------------------------
# local   = append-only local hash chain (default, always available)
# polygon = anchor daily Merkle roots to Polygon Amoy testnet (opt-in)
FINALSAY_ANCHOR=local
# Polygon Amoy (chain ID 80002). Keep the funded test wallet key private.
# Deploy contracts/FinalSayAnchor.sol on Amoy, then set the deployed address.
# FINALSAY_ANCHOR=polygon
# POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
# POLYGON_AMOY_PRIVATE_KEY=
# POLYGON_AMOY_CHAIN_ID=80002
# FINALSAY_ANCHOR_CONTRACT_ADDRESS=
# Legacy aliases FINALSAY_POLYGON_RPC_URL, FINALSAY_POLYGON_PRIVATE_KEY,
# FINALSAY_POLYGON_CHAIN_ID and FINALSAY_POLYGON_CONTRACT are also accepted.
# FINALSAY_POLYGON_RECEIPT_TIMEOUT=45

# --- Classification gating ----------------------------------------------------
# Predictions below this confidence become `unresolved` and go to the reviewer
# queue.
FINALSAY_CONFIDENCE_THRESHOLD=0.2
FINALSAY_SEMANTIC_CANDIDATE_THRESHOLD=0.55

# --- Auth ---------------------------------------------------------------------
# HS256 signing secret. Override for anything beyond a local demo.
FINALSAY_JWT_SECRET=dev-insecure-finalsay-secret-change-me

# --- OCR ----------------------------------------------------------------------
# Path to the tesseract binary. "auto" autodetects it on PATH. PDF/image OCR
# uses these Indian language models and falls back to English when unavailable.
FINALSAY_TESSERACT_CMD=auto
FINALSAY_TESSERACT_LANGUAGES=eng+hin+kan+mar
